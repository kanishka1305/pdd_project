{
  "name": "dental-ai-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Dental AI for iOS and Android: the Dental AI web application in a native app (Capacitor).",
  "scripts": {
    "prepare-web": "node scripts/prepare-web.mjs",
    "sync": "npm run prepare-web && cap sync",
    "sync:android-emulator": "cross-env DENTAI_SERVER_URL=http://10.0.2.2:8000 npm run sync",
    "sync:ios-simulator": "cross-env DENTAI_SERVER_URL=http://localhost:8000 npm run sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "build:android": "node scripts/build-android.mjs",
    "icons": "python scripts/make_icons.py"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "cross-env": "^10.1.0"
  }
}
